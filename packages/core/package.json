{
  "name": "@repo/core",
  "version": "0.0.0",
  "private": true,
  "description": "Shared, platform-neutral app logic: one folder per concern, one subpath export each.",
  "sideEffects": false,
  "exports": {
    "./analytics": "./src/analytics/index.ts",
    "./api-client": "./src/api-client/index.ts",
    "./auth": "./src/auth/index.ts",
    "./config": "./src/config/index.ts",
    "./config/react": "./src/config/react.tsx",
    "./data": "./src/data/index.ts",
    "./domain": "./src/domain/index.ts",
    "./i18n": "./src/i18n/index.ts",
    "./i18n/formatters": "./src/i18n/formatters.ts",
    "./state": "./src/state/index.ts",
    "./utils": "./src/utils/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "jest",
    "i18n:check": "node scripts/check-missing-keys.mjs"
  },
  "coverage": {
    "changedFiles": {
      "src/domain/": 90,
      "src/auth/": 85,
      "src/data/": 80,
      "src/api-client/": 80,
      "default": 70
    }
  },
  "dependencies": {
    "@tanstack/react-query": "catalog:",
    "i18next": "catalog:",
    "react-i18next": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "peerDependencies": {
    "@react-native-community/netinfo": "*",
    "expo-auth-session": "*",
    "expo-local-authentication": "*",
    "expo-localization": "*",
    "expo-secure-store": "*",
    "expo-web-browser": "*",
    "react": "*",
    "react-native": "*",
    "react-native-mmkv": "*"
  },
  "peerDependenciesMeta": {
    "@react-native-community/netinfo": {
      "optional": true
    },
    "expo-auth-session": {
      "optional": true
    },
    "expo-local-authentication": {
      "optional": true
    },
    "expo-localization": {
      "optional": true
    },
    "expo-secure-store": {
      "optional": true
    },
    "expo-web-browser": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-mmkv": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-native-community/netinfo": "catalog:",
