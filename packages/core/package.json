    "@repo/jest-config": "workspace:*",
    "@repo/testing": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@testing-library/react-native": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "expo": "catalog:",
