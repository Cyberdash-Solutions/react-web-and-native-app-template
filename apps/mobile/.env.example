# 1.12 / 4.5 — this app's environment. Only EXPO_PUBLIC_* values reach the app bundle and every
# one of them is validated by src/env.ts. Build-time secrets (SENTRY_AUTH_TOKEN, EAS_PROJECT_ID)
# live in EAS / CI secrets, never here.
EXPO_PUBLIC_APP_ENV=development
# 10.0.2.2 reaches the host machine from the Android emulator; use your LAN IP on a device.
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ANALYTICS_WRITE_KEY=
