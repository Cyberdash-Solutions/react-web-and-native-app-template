# 1.12 / 4.5 — this app's environment. Only EXPO_PUBLIC_* values reach the browser bundle and
# every one of them is validated by src/env.ts. Copy to .env.local for local overrides.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ANALYTICS_WRITE_KEY=
EXPO_PUBLIC_SITE_URL=http://localhost:8081
